# SPDX-License-Identifier: GPL-3.0-or-later
[package]
name = "{{id}}"
version = "0.1.0"
edition = "2024"
license = "GPL-3.0-or-later"
publish = false

[workspace]

[lib]
crate-type = ["cdylib"]

# For cargo (`cargo test` of the logic, an editor). The store does not
# read this file: it builds src/lib.rs with rustc alone and its own copy
# of ptyrc-app, with the flags below. `ptyrc dev check` says when
# vendor/ptyrc-app is not that copy. No other dependency is accepted.
[dependencies]
ptyrc-app = { path = "vendor/ptyrc-app" }

[profile.release]
opt-level = "s"
lto = true
codegen-units = 1
panic = "abort"
strip = true
